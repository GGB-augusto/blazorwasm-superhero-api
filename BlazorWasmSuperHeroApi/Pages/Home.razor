@page "/"
@using System.Net.Http.Json
@using BlazorWasmSuperHeroApi.Models
@inject HttpClient Http

<PageTitle>SuperHero Search</PageTitle>

<div class="text-center mb-4">
    <h1 class="text-primary">SuperHero Search</h1>
    <p class="text-muted">Busque por heróis e vilões usando a API do SuperHero.</p>
</div>

<div class="row justify-content-center mb-4">
    <div class="col-md-6 d-flex">
        <input class="form-control" @bind="busca" placeholder="Ex: batman, ironman..." />
        <button class="btn btn-primary ms-2" @onclick="BuscarHerois">Pesquisar</button>
    </div>
</div>

@if (carregando == true)
{
    <p class="text-center">Buscando...</p>
}

@if (erro != "")
{
    <div class="alert alert-danger">@erro</div>
}

@if (herois.Count > 0)
{
    <div class="row">
        @foreach (SuperHero heroi in herois)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 p-3">
                    <img src="@heroi.Image.Url" style="height: 250px; object-fit: cover;" class="mb-2" />
                    <h4>@heroi.Name <small class="text-muted">(@heroi.Biography.FullName)</small></h4>
                    <p><b>Editora:</b> @heroi.Biography.Publisher</p>
                    <hr />
                    <h6 class="text-secondary">POWERSTATS</h6>
                    <p class="mb-0">Inteligência: <b>@heroi.Powerstats.Intelligence</b></p>
                    <p class="mb-0">Força: <b>@heroi.Powerstats.Strength</b></p>
                    <p class="mb-0">Velocidade: <b>@heroi.Powerstats.Speed</b></p>
                    <p>Combate: <b>@heroi.Powerstats.Combat</b></p>
                    <h6 class="text-secondary">APARIÇÃO</h6>
                    <p>@heroi.Biography.FirstAppearance</p>
                </div>
            </div>
        }
    </div>
}

@code {
    private string busca = "";
    private string erro = "";
    private bool carregando = false;
    private List<SuperHero> herois = new List<SuperHero>();

    // token gerado no site superheroapi.com
    private string token = "20597bafab13fc8031319124d9800253";

    private async Task BuscarHerois()
    {
        erro = "";
        herois = new List<SuperHero>();

        if (busca.Trim() == "")
        {
            erro = "Digite o nome de um herói.";
            return;
        }

        carregando = true;

        try
        {
            // url com .php, como o professor mostrou
            string url = "https://www.superheroapi.com/api.php/" + token + "/search/" + busca.Trim();
            SuperHeroResponse? resultado = await Http.GetFromJsonAsync<SuperHeroResponse>(url);

            if (resultado != null && resultado.Results != null)
            {
                herois = resultado.Results;
            }
            else
            {
                erro = "Nenhum personagem encontrado para \"" + busca + "\".";
            }
        }
        catch (Exception ex)
        {
            erro = "Ocorreu um erro ao conectar com a API: " + ex.Message;
        }

        carregando = false;
    }
}